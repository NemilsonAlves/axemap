generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["fullTextSearchPostgres", "postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [postgis]
}

enum UserRole {
  VISITOR
  PRACTITIONER
  DIRIGENTE
  OGA
  EKEDI
  FILHO_DE_SANTO
  MEMBER
  CO_ADMIN
  CURATOR
  MODERATOR
  VERIFIER
  SUPPORT
  ADMIN
  SUPER_ADMIN
}

enum TerreiroStatus {
  RASCUNHO
  PENDENTE_REVISAO
  EM_REVISAO
  AGUARDANDO_DIRIGENTE
  PUBLICADO
  EM_EDICAO
  RECUSADO
  BLOQUEADO
  ARQUIVADO
  SUSPENSO
  VERIFICADO
}

enum VerificationLevel {
  BASICO
  DOCUMENTAL
  COMUNITARIO
  AVANCADO
  COMPLETO
}

enum OrganizationType {
  FEDERACAO
  CONFEDERACAO
  ASSOCIACAO
  INSTITUTO
  UNIVERSIDADE
  MUSEU
  CENTRO_CULTURAL
  PROJETO_SOCIAL
  DEFESA_LIBERDADE_RELIGIOSA
  PARCEIRO
  COMUNIDADE
  PESQUISADOR
  GRUPO_DE_PESQUISA
  TEMPLO
  ORGANIZACAO_INTERNACIONAL
}

enum OrganizationVerificationLevel {
  NAO_VERIFICADA
  REIVINDICADA
  VERIFICADA
  ORGANIZACAO_VERIFICADA
  PARCEIRO_INSTITUCIONAL
}

enum OrgRelationshipStatus {
  PENDENTE
  ACEITA
  RECUSADA
}

/**
 * Níveis de privacidade (LGPD / Privacy by Design).
 * PUBLICO: visível para todos.
 * COMUNITARIO: visível para a rede/comunidade da entidade.
 * RESTRITO: visível para membros vinculados.
 * PRIVADO: visível apenas para responsáveis.
 * SENSIVEL: nunca exposto automaticamente (ex.: informações iniciáticas,
 * dados religiosos sensíveis, dados de menores).
 */
enum NivelPrivacidade {
  PUBLICO
  COMUNITARIO
  RESTRITO
  PRIVADO
  SENSIVEL
}

enum RegiaoTipo {
  CONTINENTE
  PAIS
  REGIAO
  TERRITORIO
}

/**
 * Níveis de categoria da taxonomia multidimensional (prompt 03)
 * POVO: grupos étnicos, nações africanas e diásporas
 * TRADICAO: práticas, rituais e saberes transmitidos
 * RELIGIAO: sistemas de crenças e culto
 * ESPALTALIDADE: graus de iniciação e autoridade espiritual
 * SISTEMA_CONHECIMENTO: estruturas epistemológicas
 * SISTEMA_ADIVINHACAO: métodos de adivinhação e adivinhos
 * EXPRESSAO_CULTURAL: artes, música, dança, literatura
 * LINGUA: línguas africanas e afro-brasileiras
 * TERRITORIO: terras sagradas, quilombos, terreiros
 * REGIAO: sub-divisões geográficas (estados, províncias)
 * PAIS: países africanos e de diáspora
 * DIASPORA: comunidades africanas fora do continente
 * COMUNIDADE: grupos locais de prática
 * INSTITUICAO: templos, centros, instituições formais
 * PATRIMONIO: bens culturais, imóveis, objetos
 * EVENTO: rituais, festas, cerimônias
 * CONTEUDO: artigos, vídeos, podcasts, materiais didáticos
 */
enum TaxonomyCategory {
  POVO
  TRADICAO
  RELIGIAO
  ESPALTALIDADE
  SISTEMA_CONHECIMENTO
  SISTEMA_ADIVINHACAO
  EXPRESSAO_CULTURAL
  LINGUA
  TERRITORIO
  REGIAO
  PAIS
  DIASPORA
  COMUNIDADE
  INSTITUICAO
  PATRIMONIO
  EVENTO
  CONTEUDO
}

enum EventType {
  GIRA
  TOQUE
  FESTA_RELIGIOSA
  PALESTRA
  CURSO
  DESENVOLVIMENTO_MEDIUNICO
  ACAO_SOCIAL
}

enum CampaignStatus {
  RASCUNHO
  PENDENTE_ANALISE
  EM_ANALISE_IA
  AGUARDANDO_DOCUMENTOS
  EM_REVISAO_HUMANA
  APROVADA
  PUBLICADA
  ENCERRADA
  PRESTACAO_CONTAS
  RECUSADA
  BLOQUEADA
  ARQUIVADA
}

enum CampaignCategory {
  SOCIAL
  CULTURAL
  EDUCACIONAL
  AMBIENTAL
  EMERGENCIAL
  INFRAESTRUTURA
  PATRIMONIO_HISTORICO
  PESQUISA
  JUVENTUDE
  INCLUSAO
  EVENTOS
}

enum CampaignFundingModel {
  META_FIXA
  RECORRENTE
  EMERGENCIAL
}

enum CampaignVerificationLevel {
  NAO_VERIFICADA
  VERIFICADA
  OFICIAL
}

// ============================================================
// SAAS — Planos, Assinatura e Financeiro
// ============================================================

enum PlanoCiclo {
  MENSAL
  ANUAL
}

enum PlanoAssinaturaStatus {
  PENDENTE
  ATIVO
  ATRASADO
  EXPIRADO
  CANCELADO
}

enum PlanoPagamentoMetodo {
  PIX
  CARTAO
  BOLETO
}

enum PlanoPagamentoStatus {
  PENDENTE
  CONFIRMADO
  FALHADO
  REEMBOLSADO
  CANCELADO
}

enum TransacaoTipo {
  RECEITA
  DESPESA
}

enum TransacaoOrigem {
  PIX
  DOACAO
  MENSALIDADE
  VENDA
  TAXA_EVENTO
  OUTRO
}

enum PixChaveTipo {
  CPF
  CNPJ
  TELEFONE
  EMAIL
  ALEATORIA
}

// ============================================================
// SUSTENTABILIDADE — PROMPT 14 (Círculo de Apoiadores)
// ============================================================

enum ApoioNivel {
  SEMENTE
  GUARDIAO
  AXE
  MEMORIA
  ANCESTRALIDADE
  MANTENEDOR
}

enum ApoioPeriodicidade {
  AVULSO
  MENSAL
}

enum ApoioPlataformaStatus {
  PENDENTE
  CONFIRMADO
  FALHADO
  REEMBOLSADO
  CANCELADO
}

enum LocalizacaoVisibilidade {
  PUBLICO
  APROXIMADA
  PRIVADA
}

model Usuarios {
  id           String    @id @default(uuid())
  email        String    @unique
  nome         String
  senhaHash    String    @map("senha_hash")
  role         UserRole  @default(VISITOR)
  avatarUrl    String?   @map("avatar_url")
  isVerified   Boolean   @default(false) @map("is_verified")
  trustScore   Float     @default(0) @map("trust_score")
  refreshToken     String?   @map("refresh_token")
  resetTokenHash    String?   @map("reset_token_hash")
  resetTokenExpira  DateTime? @map("reset_token_expira")
  deletedAt         DateTime? @map("deleted_at")
  bloqueadoEm       DateTime? @map("bloqueado_em")
  motivoBloqueio    String?   @map("motivo_bloqueio")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  terreirosCriados        Terreiros[]           @relation("terreiro_criado_por")
  dirigenteDe             Terreiros[]           @relation("terreiro_dirigente")
  avaliacoes              Avaliacoes[]
  favoritos               Favoritos[]
  eventosCriados          Eventos[]             @relation("evento_criado_por")
  membroDe                MembrosTerreiro[]
  convitesEnviados        MembrosTerreiro[]     @relation("membro_convidado_por")
  matriculas              MatriculasCurso[]
  conteudosCriados        Conteudos[]           @relation("conteudo_criado_por")
  auditLogs               AuditLogs[]
  notificacoes            Notificacoes[]
  missoes                 UserMission[]
  conquistas              UserAchievement[]
  acoesEvolucao           EvolutionAction[]
  seguidores              SeguidoresTerreiro[]
  presencas               PresencaEvento[]
  indicacoesFeitas        Indicacoes[]          @relation("indicacoes_feitas")
  indicacoesRecebidas     Indicacoes[]          @relation("indicacoes_recebidas")
  reivindicacoes          ClaimRequest[]
  reivindicacoesRevisadas ClaimRequest[]        @relation("reivindicacao_revisada")
  denunciasFeitas         Denuncias[]           @relation("denuncia_criada_por")
  denunciasRevisadas      Denuncias[]           @relation("denuncia_revisada_por")
  eventosAnalytics        AnalyticsEvent[]
  feedbacks               Feedback[]
  flagOverrides           FeatureFlagOverride[]
  campanhasCriadas        Campanhas[]           @relation("campanha_criada_por")
  campanhasRevisadas      Campanhas[]           @relation("campanha_revisada_por")
  campanhasApoiadas       CampanhaApoio[]
  campanhasComentadas     CampanhaComentario[]
  instituicoesCriadas     Instituicoes[]        @relation("instituicao_criada_por")
  organizacoesCriadas     Organizacoes[]        @relation("organizacao_criada_por")
  campanhaAtualizacaos    CampanhaAtualizacao[]
  mediacoesIniciadas      Mediacoes[]           @relation("mediacao_reclamante")
  mediacoesModeradas      Mediacoes[]           @relation("mediacao_moderador")
  certificadosConcedidos  Certificado[]         @relation("certificado_concedido_por")
  certificadosRevogados   Certificado[]         @relation("certificado_revogado_por")
  evidenciasCriadas       Evidencia[]           @relation("evidencia_criada_por")
  evidenciasValidadas     Evidencia[]           @relation("evidencia_validada_por")
  fraudesCriadas          AntifraudeRegistro[]  @relation("fraude_criada_por")
  fraudesRevisadas        AntifraudeRegistro[]  @relation("fraude_revista_por")
  mediacaoMensagems       MediacaoMensagem[]
  pagamentosConfirmados   PlanoPagamento[]      @relation("plano_pagamento_confirmado")
  transacoesRegistradas   TransacaoFinanceira[] @relation("transacao_registrada")
  graphEntidadesCriadas          GraphEntidade[]                @relation("graph_entidade_criada_por")
  graphRelacionamentosCriados    GraphRelacionamento[]          @relation("graph_rel_criada_por")
  graphRelacionamentosVerificados GraphRelacionamento[]         @relation("graph_rel_verificada_por")
  graphRelacionamentosRejeitados GraphRelacionamento[]          @relation("graph_rel_rejeitada_por")
  graphHistoricoAtuado           GraphRelacionamentoHistorico[] @relation("graph_historico_por")
  duplicidadesCriadas            GraphCandidatoDuplicidade[]    @relation("duplicidade_criada_por")
  duplicidadesResolvidas         GraphCandidatoDuplicidade[]    @relation("duplicidade_resolvida_por")
  conteudosCulturaisCriados      ConteudoCultural[]             @relation("conteudo_cultural_criado_por")
  conteudosCulturaisVerificados  ConteudoCultural[]             @relation("conteudo_cultural_verificado_por")
  sourcesCriadas                 Source[]                       @relation("source_criada_por")
  sourcesVerificadas             Source[]                       @relation("source_verificada_por")
  apoiosPlataforma               ApoioPlataforma[]              @relation("apoio_plataforma_apoiador")
  apoiosConfirmados              ApoioPlataforma[]              @relation("apoio_plataforma_confirmado")
  adCampanhasAnunciante          AdCampanha[]                   @relation("ad_campanha_anunciante")
  adCampanhasRevisadas           AdCampanha[]                   @relation("ad_campanha_revisada_por")
  adPagamentosConfirmados        AdPagamento[]                  @relation("ad_pagamento_confirmado")
  pedidosMarketplaceComprador    PedidosMarketplace[]           @relation("pedido_comprador")
  episodiosSubmetidos            EpisodioTV[]                   @relation("episodio_submetido_por")
  episodiosRevisados             EpisodioTV[]                   @relation("episodio_revisado_por")
  consentRecords                 ConsentRecord[]

  @@map("usuarios")
}

model Terreiros {
  id                   String                                 @id @default(uuid())
  nome                 String
  slug                 String                                 @unique
  tradicao             String
  taxonomyCategory     TaxonomyCategory
  status               TerreiroStatus                         @default(RASCUNHO)
  trustScore           Float                                  @default(0) @map("trust_score")
  descricaoCurta       String?                                @map("descricao_curta") @db.VarChar(500)
  descricaoLonga       String?                                @map("descricao_longa") @db.Text
  cidade               String
  estado               String                                 @db.VarChar(2)
  pais                 String                                 @default("BR") @db.VarChar(2)
  continente           String                                 @default("AMERICA-SUL")
  latitude             Float
  longitude            Float
  geoPoint             Unsupported("geography(Point, 4326)")? @map("geo_point")
  telefone             String?
  email                String?
  website              String?
  horarioFuncionamento String?                                @map("horario_funcionamento")
  isPublished          Boolean                                @default(false) @map("is_published")
  isVerified           Boolean                                @default(false) @map("is_verified")
  verificationLevel    VerificationLevel                      @default(BASICO) @map("verification_level")
  fotoUrl              String?                                @map("foto_url")
  anoFundacao          Int?                                   @map("ano_fundacao")
  linhagem             String?
  instagram            String?
  whatsapp             String?
  facebook             String?
  acessibilidade       Boolean                                @default(false)
  estacionamento       String?                                @db.VarChar(20)
  codigoIndicacao      String?                                @unique @map("codigo_indicacao")
  publicadoEm          DateTime?                              @map("publicado_em")
  nivelPrivacidade     NivelPrivacidade                       @default(PUBLICO) @map("nivel_privacidade")
  visibilidadeLocalizacao LocalizacaoVisibilidade             @default(PUBLICO) @map("visibilidade_localizacao")
  createdAt            DateTime                               @default(now()) @map("created_at")
  updatedAt            DateTime                               @updatedAt @map("updated_at")
  deletedAt            DateTime?                              @map("deleted_at")

  criadoPorId           String                  @map("criado_por_id")
  criadoPor             Usuarios                @relation("terreiro_criado_por", fields: [criadoPorId], references: [id])
  dirigenteId           String?                 @map("dirigente_id")
  dirigente             Usuarios?               @relation("terreiro_dirigente", fields: [dirigenteId], references: [id])
  eventos               Eventos[]
  avaliacoes            Avaliacoes[]
  favoritos             Favoritos[]
  membros               MembrosTerreiro[]
  cursos                Cursos[]
  produtos              ProdutosMarketplace[]
  pedidosMarketplace    PedidosMarketplace[]  @relation("pedido_terreiro")
  conteudos             Conteudos[]
  acoesSociais          AcoesSociais[]
  documentosVerificacao DocumentosVerificacao[]
  fotos                 TerreiroFoto[]
  videos                TerreiroVideo[]
  missoesUsuario        UserMission[]
  conquistasUsuario     UserAchievement[]
  axScoreHistory        AxScoreHistory[]
  acoesEvolucao         EvolutionAction[]
  metasEvolucao         EvolutionGoal[]
  seguidores            SeguidoresTerreiro[]
  indicacoesEnviadas    Indicacoes[]            @relation("indicacoes_terreiro")
  acessosQR             AcessoQRCode[]
  pedidosReivindicacao  ClaimRequest[]
  denuncias             Denuncias[]
  campanhas             Campanhas[]
  organizacaoRelacionamentos OrganizacaoRelacionamentos[]
  certificados          Certificado[]
  mediacoes             Mediacoes[]
  evidencias            Evidencia[]
  complianceChecks      ComplianceChecklist[]
  assinaturas           PlanoAssinatura[]
  transacoesFinanceiras TransacaoFinanceira[]
  pixConfig             PixConfiguracao?
  episodiosTV           EpisodioTV[]

  @@index([tradicao, cidade, estado])
  @@index([trustScore])
  @@index([slug])
  @@map("terreiros")
}

model Avaliacoes {
  id            String    @id @default(uuid())
  nota          Int
  texto         String?   @db.VarChar(2000)
  pesoAvaliador Float     @default(1.0) @map("peso_avaliador")
  utilCount     Int       @default(0) @map("util_count")
  createdAt     DateTime  @default(now()) @map("created_at")
  deletedAt     DateTime? @map("deleted_at")

  usuarioId  String             @map("usuario_id")
  usuario    Usuarios           @relation(fields: [usuarioId], references: [id])
  terreiroId String             @map("terreiro_id")
  terreiro   Terreiros          @relation(fields: [terreiroId], references: [id])
  resposta   AvaliacaoResposta?

  @@unique([usuarioId, terreiroId])
  @@index([terreiroId, nota])
  @@map("avaliacoes")
}

model Eventos {
  id         String    @id @default(uuid())
  titulo     String
  descricao  String?   @db.Text
  tipo       EventType
  taxonomyCategory TaxonomyCategory
  dataInicio DateTime  @map("data_inicio")
  dataFim    DateTime? @map("data_fim")
  capacidade Int?
  isPublico  Boolean   @default(true) @map("is_publico")
  nivelPrivacidade NivelPrivacidade @default(PUBLICO) @map("nivel_privacidade")
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")
  deletedAt  DateTime? @map("deleted_at")

  terreiroId  String    @map("terreiro_id")
  terreiro    Terreiros @relation(fields: [terreiroId], references: [id])
  criadoPorId String    @map("criado_por_id")
  criadoPor   Usuarios  @relation("evento_criado_por", fields: [criadoPorId], references: [id])

  presencas PresencaEvento[]

  @@index([dataInicio, terreiroId])
  @@map("eventos")
}

model Favoritos {
  usuarioId  String    @map("usuario_id")
  usuario    Usuarios  @relation(fields: [usuarioId], references: [id])
  terreiroId String    @map("terreiro_id")
  terreiro   Terreiros @relation(fields: [terreiroId], references: [id])
  createdAt  DateTime  @default(now()) @map("created_at")

  @@id([usuarioId, terreiroId])
  @@map("favoritos")
}

model MembrosTerreiro {
  id            String   @id @default(uuid())
  papel         String   @default("COLABORADOR")
  conviteStatus String   @default("ACEITO") @map("convite_status")
  desde         DateTime @default(now())
  createdAt     DateTime @default(now()) @map("created_at")

  usuarioId      String    @map("usuario_id")
  usuario        Usuarios  @relation(fields: [usuarioId], references: [id])
  terreiroId     String    @map("terreiro_id")
  terreiro       Terreiros @relation(fields: [terreiroId], references: [id])
  convidadoPorId String?   @map("convidado_por_id")
  convidadoPor   Usuarios? @relation("membro_convidado_por", fields: [convidadoPorId], references: [id])

  @@unique([usuarioId, terreiroId])
  @@map("membros_terreiro")
}

model Cursos {
  id           String    @id @default(uuid())
  titulo       String
  descricao    String?   @db.Text
  modalidade   String?
  cargaHoraria Int?      @map("carga_horaria")
  vagas        Int?
  dataInicio   DateTime? @map("data_inicio")
  dataFim      DateTime? @map("data_fim")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")
  deletedAt    DateTime? @map("deleted_at")

  terreiroId String            @map("terreiro_id")
  terreiro   Terreiros         @relation(fields: [terreiroId], references: [id])
  matriculas MatriculasCurso[]

  @@map("cursos")
}

model MatriculasCurso {
  id        String   @id @default(uuid())
  status    String   @default("PENDENTE")
  createdAt DateTime @default(now()) @map("created_at")

  usuarioId String   @map("usuario_id")
  usuario   Usuarios @relation(fields: [usuarioId], references: [id])
  cursoId   String   @map("curso_id")
  curso     Cursos   @relation(fields: [cursoId], references: [id])

  @@unique([usuarioId, cursoId])
  @@map("matriculas_curso")
}

model ProdutosMarketplace {
  id        String    @id @default(uuid())
  nome      String
  slug      String    @unique
  descricao String?   @db.Text
  preco     Float
  precoPromocional Float? @map("preco_promocional")
  categoria String?
  estoque   Int       @default(0)
  imagens   String[]
  status    ProdutoStatus @default(ATIVO)
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  terreiroId String    @map("terreiro_id")
  terreiro   Terreiros @relation(fields: [terreiroId], references: [id])

  pedidoItens PedidoItem[]

  @@map("produtos_marketplace")
}

model PedidosMarketplace {
  id            String         @id @default(uuid())
  status        PedidoStatus   @default(CRIADO)
  subtotal      Float
  comissaoPercent Float        @map("comissao_percent") @default(10)
  comissaoValor Float          @map("comissao_valor")
  total         Float
  metodoPagamento String?      @map("metodo_pagamento")
  gatewayRef    String?        @unique @map("gateway_ref")
  observacoes   String?        @db.Text
  createdAt     DateTime       @default(now()) @map("created_at")
  updatedAt     DateTime       @updatedAt @map("updated_at")

  compradorId   String         @map("comprador_id")
  comprador     Usuarios       @relation("pedido_comprador", fields: [compradorId], references: [id])

  terreiroId    String         @map("terreiro_id")
  terreiro      Terreiros      @relation("pedido_terreiro", fields: [terreiroId], references: [id])

  itens         PedidoItem[]

  @@index([compradorId])
  @@index([terreiroId])
  @@index([status])
  @@map("pedidos_marketplace")
}

model PedidoItem {
  id            String         @id @default(uuid())
  quantidade    Int            @default(1)
  precoUnitario Float          @map("preco_unitario")
  subtotal      Float

  pedidoId      String         @map("pedido_id")
  pedido        PedidosMarketplace @relation(fields: [pedidoId], references: [id], onDelete: Cascade)

  produtoId     String         @map("produto_id")
  produto       ProdutosMarketplace @relation(fields: [produtoId], references: [id])

  @@map("pedido_itens")
}

model Conteudos {
  id                String              @id @default(uuid())
  titulo            String
  tipo              String
  conteudo          String?   @db.Text
  url               String?
  publicado         Boolean   @default(false)
  taxonomyCategory  TaxonomyCategory
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")
  deletedAt         DateTime? @map("deleted_at")

  criadoPorId String       @map("criado_por_id")
  criadoPor   Usuarios      @relation("conteudo_criado_por", fields: [criadoPorId], references: [id])
  terreiroId  String?        @map("terreiro_id")
  terreiro    Terreiros?     @relation(fields: [terreiroId], references: [id])

  @@map("conteudos")
}

model AcoesSociais {
  id        String    @id @default(uuid())
  nome      String
  descricao String?   @db.Text
  tipo      String?
  data      DateTime?
  alcance   Int?
  createdAt DateTime  @default(now()) @map("created_at")
  deletedAt DateTime? @map("deleted_at")

  terreiroId String    @map("terreiro_id")
  terreiro   Terreiros @relation(fields: [terreiroId], references: [id])

  @@map("acoes_sociais")
}

model Denuncias {
  id          String    @id @default(uuid())
  protocolo   String?   @unique @map("protocolo")
  motivo      String
  descricao   String?   @db.Text
  tipo        String    @default("TERREIRO")
  entidadeId  String    @map("entidade_id")
  status      String    @default("PENDENTE")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  resolvidoEm DateTime? @map("resolvido_em")

  criadoPorId   String?    @map("criado_por_id")
  criadoPor     Usuarios?  @relation("denuncia_criada_por", fields: [criadoPorId], references: [id])
  revisadoPorId String?    @map("revisado_por_id")
  revisadoPor   Usuarios?  @relation("denuncia_revisada_por", fields: [revisadoPorId], references: [id])
  emailContato  String?    @map("email_contato")
