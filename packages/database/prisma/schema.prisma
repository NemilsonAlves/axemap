model GraphEntidade {
  id              String             @id @default(uuid())
  entidadeTipo    GraphEntidadeTipo  @map("entidade_tipo")
  entidadeId      String             @map("entidade_id")
  nome            String
  slug            String?
  descricaoCurta  String?            @map("descricao_curta") @db.VarChar(500)
  cidade          String?
  estado          String?            @db.VarChar(2)
  latitude        Float?
  longitude       Float?
  tags            String[]           @default([])
  vetor           Float[]            @default([])
  visivel         Boolean            @default(true)
  metadata        Json?
  origem          GraphFonte         @default(USUARIO)
  criadoPorId     String?
  criadoPor       Usuarios?          @relation("graph_entidade_criada_por", fields: [criadoPorId], references: [id])
  statusIndexado  String             @default("INDEXADO") @map("status_indexado") // INDEXADO / PENDENTE / INATIVO
  indexedAt       DateTime?          @map("indexed_at")
  createdAt       DateTime           @default(now()) @map("created_at")
  updatedAt       DateTime           @updatedAt @map("updated_at")
  deletedAt       DateTime?          @map("deleted_at")

  origens GraphRelacionamento[] @relation("graph_rel_origem")
  alvos   GraphRelacionamento[] @relation("graph_rel_alvo")

  @@unique([entidadeTipo, entidadeId])
  @@index([entidadeTipo, visivel])
  @@index([cidade, estado])
  @@index([nome])
  @@map("graph_entidades")
}

model GraphRelacionamento {
  id               String                  @id @default(uuid())
  tipo             GraphRelacionamentoTipo
  rotulo           String?
  status           GraphStatus             @default(PENDENTE)
  nivelConfianca   Float                   @default(0) @map("nivel_confianca")
  fonte            GraphFonte              @default(USUARIO)
  evidencia        String?
  validoDe         DateTime?               @map("valido_de")
  validoAte        DateTime?               @map("valido_ate")
  motivo           String?
  versao           Int                     @default(1)
  createdAt        DateTime                @default(now()) @map("created_at")
  updatedAt        DateTime                @updatedAt @map("updated_at")
  deletedAt        DateTime?               @map("deleted_at")

  origemEntidadeId String          @map("origem_entidade_id")
  origemEntidade   GraphEntidade   @relation("graph_rel_origem", fields: [origemEntidadeId], references: [id])
  alvoEntidadeId   String          @map("alvo_entidade_id")
  alvoEntidade     GraphEntidade   @relation("graph_rel_alvo", fields: [alvoEntidadeId], references: [id])

  criadoPorId       String?
  criadoPor         Usuarios?      @relation("graph_rel_criada_por", fields: [criadoPorId], references: [id])
  verificadoPorId   String?
  verificadoPor     Usuarios?      @relation("graph_rel_verificada_por", fields: [verificadoPorId], references: [id])
  rejeitadoPorId    String?
  rejeitadoPor      Usuarios?      @relation("graph_rel_rejeitada_por", fields: [rejeitadoPorId], references: [id])
  verificadoEm      DateTime?      @map("verificado_em")
  historico         GraphRelacionamentoHistorico[]
  sourceId          String?        @map("source_id")
  source            Source?        @relation(fields: [sourceId], references: [id])

  @@unique([tipo, origemEntidadeId, alvoEntidadeId])
  @@index([status, fonte])
  @@index([origemEntidadeId])
  @@index([alvoEntidadeId])
  @@index([sourceId])
  @@map("graph_relacionamentos")
}

model GraphRelacionamentoHistorico {
  id                 String   @id @default(uuid())
  versao             Int
  acao               String // CRIADO / ATUALIZADO / VERIFICADO / REJEITADO / SUSPENSO / DELETADO
