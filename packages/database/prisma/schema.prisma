/// Publicidade → Exposição publicitária identificada. Nunca altera Trust.
model AdCampanha {
  id              String      @id @default(uuid())
  titulo          String
  descricao       String?     @db.Text
  destinatarioUrl String?     @map("destinatario_url") @db.VarChar(1000)
  imagemUrl       String?     @map("imagem_url")
  placement       AdPlacement
  category        AdCategory
  cidadeAlvo      String?     @map("cidade_alvo")
  estadoAlvo      String?     @map("estado_alvo") @db.VarChar(2)
  orcamentoBRL    Float       @map("orcamento_brl")
  status          AdStatus    @default(RASCUNHO)
  motivoRejeicao  String?     @map("motivo_rejeicao") @db.VarChar(500)
  impressoes      Int         @default(0)
  cliques         Int         @default(0)
  dataInicio      DateTime    @map("data_inicio")
  dataFim         DateTime?   @map("data_fim")
  publicadoEm     DateTime?   @map("publicado_em")
  revisadoEm      DateTime?   @map("revisado_em")
  createdAt       DateTime    @default(now()) @map("created_at")
  updatedAt       DateTime    @updatedAt @map("updated_at")

  anuncianteId  String    @map("anunciante_id")
  anunciante    Usuarios  @relation("ad_campanha_anunciante", fields: [anuncianteId], references: [id])
  revisadoPorId String?   @map("revisado_por_id")
  revisadoPor   Usuarios? @relation("ad_campanha_revisada_por", fields: [revisadoPorId], references: [id])

  pagamentos AdPagamento[]

  @@index([status, dataInicio])
  @@index([placement, status])
  @@index([anuncianteId, status])
  @@map("ad_campanhas")
}

/// Pagamento associado a uma campanha publicitária.
/// Pagamento NÃO altera Trust Score nem posição orgânica.
model AdPagamento {
  id         String    @id @default(uuid())
  valor      Float
  status     String    @default("PENDENTE") // PENDENTE / CONFIRMADO / FALHADO / REEMBOLSADO
  gatewayRef String?   @map("gateway_ref")
  pagoEm     DateTime? @map("pago_em")
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")

  campanhaId      String       @map("campanha_id")
  campanha        AdCampanha   @relation(fields: [campanhaId], references: [id])
  confirmadoPorId String?      @map("confirmado_por_id")
  confirmadoPor   Usuarios?    @relation("ad_pagamento_confirmado", fields: [confirmadoPorId], references: [id])

  @@index([campanhaId, status])
  @@map("ad_pagamentos")
}

// ============================================================
// PAYMENT ABSTRACTION — Registro genérico de eventos de pagamento
// (Prompt 14, seção 27–28)
// Auditoria de webhooks e idempotência.
// ============================================================

model PaymentWebhookLog {
  id          String   @id @default(uuid())
  provider    String // MOCK / MERCADO_PAGO / STRIPE / PAGARME / ASAAS
  gatewayRef  String   @map("gateway_ref")
  eventType   String   @map("event_type")
  status      String
  origin      String // APOIO / SUBSCRIPTION / CAMPAIGN / AD
  amountBRL   Float?   @map("amount_brl")
  rawPayload  Json?    @map("raw_payload")
  processado  Boolean  @default(false)
  erroMensagem String? @map("erro_mensagem") @db.VarChar(500)
  occurredAt  DateTime @map("occurred_at")
  createdAt   DateTime @default(now()) @map("created_at")

  @@unique([provider, gatewayRef, eventType])
  @@index([processado, createdAt])
  @@index([gatewayRef])
  @@map("payment_webhook_logs")
}

// ============================================================
// TV AXÉMAP — Episódios, Programas e Submissões
// Módulo de mídia cultural. Conteúdo enviado pelas casas passa
// por moderação antes de ser publicado.
// ============================================================

enum EpisodioStatus {
  RASCUNHO
  AGUARDANDO_REVISAO
  EM_REVISAO
  APROVADO
  PUBLICADO
  PAUSADO
  REJEITADO
  ARQUIVADO
}

enum EpisodioTipo {
  DOCUMENTARIO
  ENTREVISTA
  RITUAL_PUBLICO
  FESTA_CULTURAL
  MUSICA
  EDUCATIVO
  INSTITUCIONAL
  EVENTO_AO_VIVO
  CONTEUDO_COMUNIDADE
}

/// Episódio da TV AxéMap.
/// Conteúdo cultural enviado pelas comunidades e publicado após moderação.
model EpisodioTV {
  id           String          @id @default(uuid())
  titulo       String
  slug         String          @unique
  descricao    String?         @db.Text
  tipo         EpisodioTipo    @default(DOCUMENTARIO)
  status       EpisodioStatus  @default(RASCUNHO)
  /// ID do vídeo no YouTube (preenchido após upload/aprovação)
  youtubeId    String?         @map("youtube_id")
  /// URL direta do vídeo (S3 ou CDN, alternativa ao YouTube)
  videoUrl     String?         @map("video_url")
  thumbnailUrl String?         @map("thumbnail_url")
  duracao      Int?            /// duração em segundos
  tags         String[]        @default([])
  tradicao     String?
  /// Visibilidade: PUBLICO = qualquer pessoa; COMUNITARIO = membros; PRIVADO = só admins
  nivelPrivacidade NivelPrivacidade @default(PUBLICO) @map("nivel_privacidade")
  motivoRejeicao String?       @map("motivo_rejeicao") @db.VarChar(500)
  visualizacoes  Int           @default(0)
  publicadoEm  DateTime?       @map("publicado_em")
  revisadoEm   DateTime?       @map("revisado_em")
  createdAt    DateTime        @default(now()) @map("created_at")
  updatedAt    DateTime        @updatedAt @map("updated_at")
  deletedAt    DateTime?       @map("deleted_at")

  /// Casa que submeteu o conteúdo (opcional — pode ser conteúdo institucional)
  terreiroId   String?         @map("terreiro_id")
  terreiro     Terreiros?      @relation(fields: [terreiroId], references: [id])
  submitorId   String          @map("submitor_id")
  submitor     Usuarios        @relation("episodio_submetido_por", fields: [submitorId], references: [id])
  revisadoPorId String?        @map("revisado_por_id")
  revisadoPor  Usuarios?       @relation("episodio_revisado_por", fields: [revisadoPorId], references: [id])

  @@index([status, publicadoEm])
  @@index([tipo, status])
  @@index([terreiroId])
  @@index([slug])
  @@map("episodios_tv")
}

// ============================================================
// CONSENTIMENTO LGPD — Registro server-side de consentimento
// (LGPD Art. 7 / Art. 11 / ANPD Resolução CD/ANPD nº 2/2022)
//
// REGRA: ipHash e userAgentHash são SHA-256 do IP/UA — NUNCA
// o dado bruto. userId pode ser null para sessões anônimas.
// ============================================================

model ConsentRecord {
  id             String    @id @default(cuid())
  userId         String?   @map("user_id")
  sessionId      String?   @map("session_id")
  consentVersion String    @map("consent_version")
  essential      Boolean   @default(true)
  analytics      Boolean   @default(false)
  marketing      Boolean   @default(false)
  preferences    Boolean   @default(false)
  source         String    // "banner" | "settings" | "api"
  ipHash         String?   @map("ip_hash")    // SHA-256 de IP — nunca IP bruto
  userAgentHash  String?   @map("user_agent_hash") // SHA-256 de UA
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")
  revokedAt      DateTime? @map("revoked_at")

  user Usuarios? @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([sessionId])
  @@map("consent_records")
}
