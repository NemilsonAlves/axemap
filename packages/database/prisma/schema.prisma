  depois             Json?
  porId              String?  @map("por_id")
  por                Usuarios? @relation("graph_historico_por", fields: [porId], references: [id])
  createdAt          DateTime @default(now()) @map("created_at")

  relacionamentoId String                  @map("relacionamento_id")
  relacionamento   GraphRelacionamento     @relation(fields: [relacionamentoId], references: [id], onDelete: Cascade)

  @@index([relacionamentoId])
  @@map("graph_relacionamentos_historico")
}

