{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "name": "axemap-breakpoints",
  "description": "Breakpoints AxéMap (Tailwind v4). Base 375px (mobile-first).",
  "tokens": {
    "xs": { "$type": "dimension", "$value": "30rem" },
    "sm": { "$type": "dimension", "$value": "40rem" },
    "md": { "$type": "dimension", "$value": "48rem" },
    "lg": { "$type": "dimension", "$value": "64rem" },
    "xl": { "$type": "dimension", "$value": "80rem" },
    "2xl": { "$type": "dimension", "$value": "96rem" },
    "3xl": { "$type": "dimension", "$value": "120rem" },
    "4xl": { "$type": "dimension", "$value": "160rem" },
    "containerPage": { "$type": "dimension", "$value": "80rem" },
    "containerNarrow": { "$type": "dimension", "$value": "64rem" }
  }
}
