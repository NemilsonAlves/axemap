{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "name": "axemap-shadows",
  "description": "Sombras cálidas (hsl barro 24 30% 30%) — profundidade com calor, nunca fria.",
  "tokens": {
    "xs": { "$type": "shadow", "$value": "0 1px 2px hsl(24 30% 30% / 0.04), 0 1px 1px hsl(24 30% 30% / 0.03)" },
    "sm": { "$type": "shadow", "$value": "0 1px 2px hsl(24 30% 30% / 0.05), 0 2px 6px hsl(24 30% 30% / 0.05)" },
    "md": { "$type": "shadow", "$value": "0 2px 4px hsl(24 30% 30% / 0.06), 0 8px 20px hsl(24 30% 30% / 0.08)" },
    "lg": { "$type": "shadow", "$value": "0 4px 8px hsl(24 30% 30% / 0.07), 0 16px 40px hsl(24 30% 30% / 0.12)" },
    "xl": { "$type": "shadow", "$value": "0 8px 16px hsl(24 30% 30% / 0.1), 0 28px 64px hsl(24 30% 30% / 0.18)" },
    "copper": { "$type": "shadow", "$value": "0 6px 24px hsl(18 70% 40% / 0.28)" },
    "dark-xs": { "$type": "shadow", "$value": "0 1px 2px hsl(0 0% 0% / 0.4), 0 1px 1px hsl(0 0% 0% / 0.3)" },
    "dark-sm": { "$type": "shadow", "$value": "0 1px 2px hsl(0 0% 0% / 0.4), 0 2px 8px hsl(0 0% 0% / 0.4)" },
    "dark-md": { "$type": "shadow", "$value": "0 2px 4px hsl(0 0% 0% / 0.4), 0 10px 24px hsl(0 0% 0% / 0.45)" },
    "dark-lg": { "$type": "shadow", "$value": "0 4px 8px hsl(0 0% 0% / 0.45), 0 18px 44px hsl(0 0% 0% / 0.5)" },
    "dark-xl": { "$type": "shadow", "$value": "0 8px 16px hsl(0 0% 0% / 0.5), 0 30px 72px hsl(0 0% 0% / 0.6)" },
    "dark-copper": { "$type": "shadow", "$value": "0 6px 28px hsl(18 78% 50% / 0.35)" }
  }
}
