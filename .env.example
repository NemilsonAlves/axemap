# =============================================================================
# AXÉMAP — Environment Variables (REFERÊNCIA)
#
# ⚠️ SOMENTE PLACEHOLDERS. NUNCA coloque valores reais neste arquivo.
# ⚠️ Copie para .env (desenvolvimento) ou .env.production (VPS) e preencha.
# ⚠️ .env.production NÃO pode ser versionado (já está no .gitignore).
#
# Gere secrets fortes em produção:
#   openssl rand -hex 32      (JWT_SECRET / JWT_REFRESH_SECRET)
# =============================================================================

# ─────────────────────────────────────────────────────────────────────────────
# PRODUÇÃO (VPS Contabo) — valores de exemplo para o .env.production
# ─────────────────────────────────────────────────────────────────────────────
# NODE_ENV=production
# PORT=3001
#
# # Banco de dados
# DATABASE_URL=postgresql://axemap:CHANGE_ME_DB_PASSWORD@postgres:5432/axemap
# SHADOW_DATABASE_URL=postgresql://axemap:CHANGE_ME_DB_PASSWORD@127.0.0.1:5432/axemap_shadow
# MIGRATION_DATABASE_URL=postgresql://axemap:CHANGE_ME_DB_PASSWORD@127.0.0.1:5432/axemap
# POSTGRES_USER=axemap
# POSTGRES_PASSWORD=CHANGE_ME_DB_PASSWORD
# POSTGRES_DB=axemap
#
# # JWT — gerar com: openssl rand -hex 32
# JWT_SECRET=CHANGE_ME_64_HEX_CHARS
# JWT_REFRESH_SECRET=CHANGE_ME_64_HEX_CHARS
# JWT_EXPIRES_IN=15m
#
# # URLs
# # FRONTEND_URL pode conter múltiplas origens separadas por vírgula (CORS).
# FRONTEND_URL=https://axemap.com.br,https://www.axemap.com.br
# APP_URL=https://axemap.com.br
# # NEXT_PUBLIC_API_URL é SEM /api/v1 (o código web anexa /api/v1 nas rotas).
# NEXT_PUBLIC_API_URL=https://api.axemap.com.br
# NEXT_PUBLIC_TV_MUSIC_URL=https://storage.axemap.com.br/audio/de-volta.mp3
#
# # Redis
# REDIS_HOST=redis
# REDIS_PORT=6379
#
# # Storage (MinIO) — usar o MESMO par de credenciais para STORAGE_ACCESS_KEY
# # e STORAGE_SECRET_KEY (o compose usa como MINIO_ROOT_USER/PASSWORD).
# STORAGE_TYPE=minio
# STORAGE_REGION=us-east-1
# STORAGE_ENDPOINT=http://storage:9000
# STORAGE_ACCESS_KEY=CHANGE_ME_MINIO_USER
# STORAGE_SECRET_KEY=CHANGE_ME_MINIO_PASSWORD
# STORAGE_BUCKET=axemap
# STORAGE_PUBLIC_URL=https://storage.axemap.com.br
# STORAGE_FORCE_PATH_STYLE=true
#
# # E-mail (provider http = API transacional; console = logs)
# MAIL_PROVIDER=http
# MAIL_API_URL=https://api.resend.com/emails
# MAIL_API_KEY=CHANGE_ME_MAIL_KEY
#
# # Logs
# LOG_LEVEL=info

# ─────────────────────────────────────────────────────────────────────────────
# DESENVOLVIMENTO — valores locais (copiar para .env)
# ─────────────────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3001
API_URL=http://localhost:3001
NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_TV_MUSIC_URL=

# Database (local)
DATABASE_URL=postgresql://axemap:axemap_dev@localhost:5432/axemap
SHADOW_DATABASE_URL=postgresql://axemap:axemap_dev@localhost:5432/axemap_shadow

# Redis (local)
REDIS_HOST=localhost
REDIS_PORT=6379

# JWT (local — NUNCA usar estes valores em produção; a API aborta o boot se
# detectar placeholder em produção)
JWT_SECRET=development-secret
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=development-secret

# URLs (local)
FRONTEND_URL=http://localhost:3000
APP_URL=http://localhost:3000

# Storage (local MinIO)
STORAGE_TYPE=minio
STORAGE_REGION=us-east-1
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_ACCESS_KEY=axemap
STORAGE_SECRET_KEY=axemap_minio_dev
STORAGE_BUCKET=axemap
STORAGE_PUBLIC_URL=http://localhost:9000
STORAGE_FORCE_PATH_STYLE=true

# E-mail (local = console)
MAIL_PROVIDER=console

LOG_LEVEL=debug

# =============================================================================
# MATRIZ DE VARIÁVEIS
# =============================================================================
# | Variável                    | Obrigatória (prod) | Secret | Público | Função                                                   |
# |-----------------------------|--------------------|--------|---------|----------------------------------------------------------|
# | NODE_ENV                    | Sim                | Não    | Não     | Ambiente (production/development)                        |
# | PORT                        | Sim                | Não    | Não     | Porta HTTP da API (3001)                                 |
# | DATABASE_URL                | Sim                | Sim    | Não     | Conexão da API com PostgreSQL (host "postgres" no Docker)|
# | SHADOW_DATABASE_URL         | Sim (migrations)   | Sim    | Não     | Shadow DB do Prisma — NUNCA igual a DATABASE_URL         |
# | MIGRATION_DATABASE_URL      | Sim (migrations)   | Sim    | Não     | Conexão do host p/ migrate-deploy (127.0.0.1:5432)       |
# | POSTGRES_USER/PASSWORD/DB   | Sim (compose)      | Pwd=Sim| Não     | Criação/credenciais do container PostgreSQL              |
# | JWT_SECRET                  | Sim                | Sim    | Não     | Assinatura de access tokens (JwtModule/getOrThrow)       |
# | JWT_REFRESH_SECRET          | Sim                | Sim    | Não     | Assinatura de refresh tokens (auth.service)              |
# | JWT_EXPIRES_IN              | Não (default 15m)  | Não    | Não     | TTL do access token (refresh fixo em 7d no código)      |
# | FRONTEND_URL                | Sim                | Não    | Não     | Origens CORS permitidas (vírgula p/ múltiplas: apex+www)|
# | APP_URL                     | Sim                | Não    | Não     | Base de URLs em e-mails (reset de senha)                 |
# | NEXT_PUBLIC_API_URL         | Sim (build)        | Não    | Sim     | URL pública da API SEM /api/v1 — inlined no next build  |
# | NEXT_PUBLIC_TV_MUSIC_URL    | Não                | Não    | Sim     | URL do áudio da TV AxéMap — inlined no "next build"      |
# | REDIS_HOST / REDIS_PORT     | Sim                | Não    | Não     | Conexão com Redis (host "redis" no Docker)               |
# | STORAGE_TYPE                | Sim                | Não    | Não     | minio/s3/r2                                              |
# | STORAGE_REGION              | Não (default auto) | Não    | Não     | Região do S3/R2                                          |
# | STORAGE_ENDPOINT            | Sim                | Não    | Não     | Endpoint interno do storage ("http://storage:9000")      |
# | STORAGE_ACCESS_KEY          | Sim                | Sim    | Não     | Chave de acesso (usa como MINIO_ROOT_USER)               |
# | STORAGE_SECRET_KEY          | Sim                | Sim    | Não     | Segredo (usa como MINIO_ROOT_PASSWORD)                   |
# | STORAGE_BUCKET              | Sim                | Não    | Não     | Bucket padrão (axemap)                                   |
# | STORAGE_PUBLIC_URL          | Sim                | Não    | Não     | Origem pública dos arquivos ("https://storage.axemap.com.br") |
# | STORAGE_FORCE_PATH_STYLE    | Não (default true) | Não    | Não     | Path-style do S3 (obrigatório p/ MinIO)                  |
# | MAIL_PROVIDER               | Não (default console)| Não   | Não     | console|http                                             |
# | MAIL_API_URL                | Sim se provider http| Não    | Não     | Endpoint da API de e-mail                                |
# | MAIL_API_KEY                | Sim se provider http| Sim    | Não     | Chave da API de e-mail                                   |
# | LOG_LEVEL                   | Não (default info) | Não    | Não     | Nível de log (pino)                                      |
# | API_URL                     | Não (dev only)     | Não    | Não     | URL da API usada por scripts locais (dev)                |
#
# Legenda: Secret = tratar como segredo (nunca commitar, nunca imprimir em logs).
# Público = variável NEXT_PUBLIC_* (fica visível no bundle do cliente web —
#           nunca colocar segredos em NEXT_PUBLIC_*).
# =============================================================================