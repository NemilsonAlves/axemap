# =============================================================================
# AXÉMAP — Environment Variables
# Copy this file to .env and fill in the values
# =============================================================================

# Database
# DATABASE_URL: conexão principal (produção usa host da VPS, não localhost)
DATABASE_URL=postgresql://axemap:axemap_dev@localhost:5432/axemap

# Shadow database: banco SEPARADO usado pelo Prisma em migrations.
# REGRA CRÍTICA: NUNCA pode ser igual a DATABASE_URL.
# Use um banco dedicado (ex: axemap_shadow). A proteção está em
# scripts/check-shadow-db.sh e aborta a operação se forem iguais.
SHADOW_DATABASE_URL=postgresql://axemap:axemap_dev@localhost:5432/axemap_shadow

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# JWT
JWT_SECRET=change-this-in-production
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change-this-in-production
JWT_REFRESH_EXPIRES_IN=7d

# NextAuth (web only)
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=change-this-in-production

# API
API_URL=http://localhost:3001
NEXT_PUBLIC_API_URL=http://localhost:3001
PORT=3001

# CORS — comma-separated allowed origins (production must set this)
FRONTEND_URL=http://localhost:3000

# Environment
NODE_ENV=development
LOG_LEVEL=debug

# =============================================================================
# STORAGE (S3 / MinIO / Cloudflare R2)
# =============================================================================
STORAGE_TYPE=minio
STORAGE_REGION=us-east-1
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_ACCESS_KEY=change-this
STORAGE_SECRET_KEY=change-this
STORAGE_BUCKET=axemap
# Origin-base do storage (SEM o bucket). A URL pública final será
# {STORAGE_PUBLIC_URL}/{STORAGE_BUCKET}/{key}. Em produção use o domínio real
# (ex: https://storage.axemap.com.br).
STORAGE_PUBLIC_URL=http://localhost:9000
STORAGE_FORCE_PATH_STYLE=true

# =============================================================================
# EMAIL (Resend or SMTP)
# =============================================================================
# MAIL_PROVIDER=console|http   (console = logs no dev; http = API transacional)
# MAIL_API_URL=https://api.resend.com/emails
# MAIL_API_KEY=re_xxxxx
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=user@example.com
# SMTP_PASS=change-this

# =============================================================================
# WHATSAPP (Twilio or Evolution API)
# =============================================================================
# WHATSAPP_API_URL=http://localhost:8080
# WHATSAPP_API_KEY=change-this
# TWILIO_ACCOUNT_SID=ACxxxxx
# TWILIO_AUTH_TOKEN=change-this

# =============================================================================
# MAPS (Google Maps or Mapbox)
# =============================================================================
# GOOGLE_MAPS_API_KEY=AIzaxxxxx
# MAPBOX_TOKEN=pk.eyJxxxx

# =============================================================================
# AI (OpenAI, Anthropic, or Gemini)
# =============================================================================
# OPENAI_API_KEY=sk-xxxxx
# ANTHROPIC_API_KEY=sk-ant-xxxxx
# GEMINI_API_KEY=xxxxx

# =============================================================================
# OAUTH (Google Login)
# =============================================================================
# GOOGLE_CLIENT_ID=xxxxx.apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=xxxxx

# =============================================================================
# PAYMENTS (Asaas, Mercado Pago, or Stripe)
# =============================================================================
# ASAAS_API_KEY=change-this
# MERCADO_PAGO_TOKEN=change-this
# STRIPE_SECRET_KEY=sk_live_xxxxx

# =============================================================================
# SENTRY (Error Tracking)
# =============================================================================
# SENTRY_DSN=https://xxxxx@sentry.io/xxxxx

# =============================================================================
# TV AXÉMAP — Mídia
# =============================================================================
# URL pública do arquivo de áudio do mini player.
# Em dev usa o arquivo local em public/audio/axemap/de-volta.mp3 (fallback).
# Em produção, apontar para o CDN/Storage onde o arquivo estiver hospedado.
# ATENÇÃO: verificar direitos de uso do arquivo antes de publicar em produção.
# NEXT_PUBLIC_TV_MUSIC_URL=https://storage.axemap.com.br/audio/de-volta.mp3

